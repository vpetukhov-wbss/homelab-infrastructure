{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HomeLab Pulse host sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sampleId", "observedAt", "kind", "values"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sampleId": { "type": "string", "format": "uuid" },
    "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "kind": { "const": "host" },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootId", "cpuTimesSeconds", "memory", "loadAverage", "uptimeSeconds", "filesystems", "network", "temperaturesCelsius"],
      "properties": {
        "bootId": { "type": "string", "format": "uuid" },
        "cpuTimesSeconds": {
          "type": "object",
          "required": ["user", "nice", "system", "idle", "iowait", "irq", "softirq", "steal"],
          "maxProperties": 8,
          "additionalProperties": { "$ref": "#/$defs/nonnegative" }
        },
        "memory": {
          "type": "object",
          "required": ["totalBytes", "availableBytes", "swapTotalBytes", "swapFreeBytes"],
          "maxProperties": 4,
          "additionalProperties": { "$ref": "#/$defs/bytes" }
        },
        "loadAverage": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/nonnegative" }
        },
        "uptimeSeconds": { "$ref": "#/$defs/nonnegative" },
        "filesystems": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": {
            "type": "object",
            "required": ["totalBytes", "availableBytes"],
            "maxProperties": 2,
            "additionalProperties": { "$ref": "#/$defs/bytes" }
          }
        },
        "network": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": {
            "type": "object",
            "required": ["rxBytes", "txBytes"],
            "maxProperties": 2,
            "additionalProperties": { "$ref": "#/$defs/bytes" }
          }
        },
        "temperaturesCelsius": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": { "type": "number" }
        },
        "fanSpeedsRpm": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "diskSmart": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": { "$ref": "#/$defs/diskSmartReading" }
        },
        "dockerWorkloads": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": { "$ref": "#/$defs/dockerWorkloadReading" }
        },
        "dockerVolumes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": { "$ref": "#/$defs/dockerVolumeReading" }
        },
        "nginx": {
          "$ref": "#/$defs/nginxReading"
        },
        "sqliteStorage": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": { "$ref": "#/$defs/sqliteStorageReading" }
        },
        "redis": {
          "$ref": "#/$defs/redisReading"
        },
        "postgresql": {
          "$ref": "#/$defs/postgresqlReading"
        },
        "rabbitmq": {
          "$ref": "#/$defs/rabbitmqReading"
        },
        "gitea": {
          "$ref": "#/$defs/giteaReading"
        }
      }
    }
  },
  "$defs": {
    "alias": { "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "bytes": { "type": "integer", "minimum": 0 },
    "nonnegative": { "type": "number", "minimum": 0 },
    "dockerVolumeReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "unavailable", "stale"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "usedBytes": { "$ref": "#/$defs/bytes" },
        "filesystemCapacityBytes": { "$ref": "#/$defs/bytes" },
        "filesystemAvailableBytes": { "$ref": "#/$defs/bytes" }
      },
      "dependentRequired": {
        "filesystemCapacityBytes": ["filesystemAvailableBytes"],
        "filesystemAvailableBytes": ["filesystemCapacityBytes"]
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": {
        "required": ["observedAt"],
        "anyOf": [{ "required": ["usedBytes"] }, { "required": ["filesystemCapacityBytes"] }]
      },
      "else": {
        "propertyNames": { "enum": ["status", "observedAt"] },
        "if": { "properties": { "status": { "const": "stale" } } },
        "then": { "required": ["observedAt"] }
      }
    },
    "dockerWorkloadReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "unavailable", "stale"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "state": { "enum": ["created", "running", "paused", "restarting", "removing", "exited", "dead"] },
        "health": { "enum": ["starting", "healthy", "unhealthy"] },
        "restartCount": { "type": "integer", "minimum": 0 },
        "restartPolicy": { "enum": ["no", "always", "on-failure", "unless-stopped"] },
        "memoryLimitBytes": { "type": "integer", "minimum": 1 },
        "cpuLimitCores": { "type": "number", "exclusiveMinimum": 0 },
        "usage": { "$ref": "#/$defs/dockerWorkloadUsage" },
        "volumeAttachments": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/alias" },
          "additionalProperties": { "enum": ["ro", "rw", "mixed"] }
        }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": { "required": ["observedAt", "state", "restartCount", "restartPolicy"] },
      "else": {
        "maxProperties": 2,
        "if": { "properties": { "status": { "const": "stale" } } },
        "then": { "required": ["observedAt"] },
        "propertyNames": { "enum": ["status", "observedAt"] }
      }
    },
    "dockerWorkloadUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "cpuUsageCores": { "$ref": "#/$defs/nonnegative" },
        "memoryUsageBytes": { "$ref": "#/$defs/bytes" }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": {
        "anyOf": [
          { "required": ["cpuUsageCores"] },
          { "required": ["memoryUsageBytes"] }
        ]
      },
      "else": { "maxProperties": 1 }
    },
    "giteaReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "databaseHealthy": { "type": "boolean" },
        "cacheHealthy": { "type": "boolean" },
        "responseTimeMs": { "type": "integer", "minimum": 0 }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": { "required": ["databaseHealthy", "cacheHealthy", "responseTimeMs"] },
      "else": { "maxProperties": 2 }
    },
    "rabbitmqReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "messages": { "type": "integer", "minimum": 0 },
        "messagesReady": { "type": "integer", "minimum": 0 },
        "messagesUnacknowledged": { "type": "integer", "minimum": 0 },
        "consumers": { "type": "integer", "minimum": 0 }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": { "required": ["messages", "messagesReady", "messagesUnacknowledged", "consumers"] },
      "else": { "maxProperties": 2 }
    },
    "postgresqlReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "statsResetAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "inRecovery": { "type": "boolean" },
        "databaseBytes": { "$ref": "#/$defs/bytes" },
        "connectedBackends": { "type": "integer", "minimum": 0 },
        "commitsTotal": { "type": "integer", "minimum": 0 },
        "rollbacksTotal": { "type": "integer", "minimum": 0 },
        "bufferHitsTotal": { "type": "integer", "minimum": 0 },
        "blocksReadTotal": { "type": "integer", "minimum": 0 },
        "deadlocksTotal": { "type": "integer", "minimum": 0 }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": {
        "required": [
          "inRecovery", "databaseBytes", "connectedBackends", "commitsTotal", "rollbacksTotal",
          "bufferHitsTotal", "blocksReadTotal", "deadlocksTotal"
        ]
      },
      "else": { "maxProperties": 2 }
    },
    "redisReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "usedMemoryBytes": { "$ref": "#/$defs/bytes" },
        "maxMemoryBytes": { "$ref": "#/$defs/bytes" },
        "operationsPerSecond": { "type": "integer", "minimum": 0 },
        "keyspaceHitsTotal": { "type": "integer", "minimum": 0 },
        "keyspaceMissesTotal": { "type": "integer", "minimum": 0 },
        "evictedKeysTotal": { "type": "integer", "minimum": 0 },
        "connectedClients": { "type": "integer", "minimum": 0 },
        "aofCurrentSizeBytes": { "$ref": "#/$defs/bytes" }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": { "required": ["usedMemoryBytes"] },
      "else": { "maxProperties": 2 }
    },
    "sqliteStorageReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "databaseBytes": { "$ref": "#/$defs/bytes" },
        "walBytes": { "$ref": "#/$defs/bytes" },
        "sharedMemoryBytes": { "$ref": "#/$defs/bytes" },
        "rollbackJournalBytes": { "$ref": "#/$defs/bytes" },
        "totalBytes": { "$ref": "#/$defs/bytes" }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": {
        "required": ["databaseBytes", "walBytes", "sharedMemoryBytes", "rollbackJournalBytes", "totalBytes"]
      },
      "else": { "maxProperties": 2 }
    },
    "nginxReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "activeConnections": { "type": "integer", "minimum": 0 },
        "acceptedConnectionsTotal": { "type": "integer", "minimum": 0 },
        "handledConnectionsTotal": { "type": "integer", "minimum": 0 },
        "requestsTotal": { "type": "integer", "minimum": 0 },
        "readingConnections": { "type": "integer", "minimum": 0 },
        "writingConnections": { "type": "integer", "minimum": 0 },
        "waitingConnections": { "type": "integer", "minimum": 0 }
      },
      "if": { "properties": { "status": { "const": "available" } } },
      "then": {
        "required": [
          "activeConnections", "acceptedConnectionsTotal", "handledConnectionsTotal", "requestsTotal",
          "readingConnections", "writingConnections", "waitingConnections"
        ]
      },
      "else": { "maxProperties": 2 }
    },
    "diskSmartReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "stale", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "temperatureCelsius": { "type": "integer" },
        "healthPassed": { "type": "boolean" },
        "nvmePercentageUsed": { "type": "integer", "minimum": 0 },
        "nvmeMediaErrors": { "type": "integer", "minimum": 0 },
        "reallocatedSectors": { "type": "integer", "minimum": 0 },
        "pendingSectors": { "type": "integer", "minimum": 0 },
        "offlineUncorrectableSectors": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": { "required": ["observedAt"], "minProperties": 3 }
        },
        {
          "if": { "properties": { "status": { "const": "stale" } } },
          "then": { "required": ["observedAt"], "maxProperties": 2 }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "maxProperties": 1 }
        }
      ]
    }
  }
}
