# Managed by Ansible (homelab) — MongoDB on {{ inventory_hostname }}
# Host network on purpose: mongod binds the overlay address itself, so its traffic passes
# ufw's INPUT chain. A published port would bypass ufw, and the replica set member could
# not reach itself at the overlay address through Docker's proxy.
name: {{ mongodb_container }}
services:
  mongodb:
    image: {{ mongodb_image }}
    container_name: {{ mongodb_container }}
    restart: unless-stopped
    network_mode: host
    user: "{{ mongodb_uid }}:{{ mongodb_uid }}"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: {{ mongodb_memory_limit }}
    pids_limit: 512
    command:
      - mongod
      - --replSet={{ mongodb_replset }}
      - --keyFile=/etc/mongodb/keyfile
      - --bind_ip=127.0.0.1,{{ wg_overlay_ip }}
      - --port={{ mongodb_port }}
      - --wiredTigerCacheSizeGB={{ mongodb_cache_gb }}
    environment:
      HOME: /tmp
      MONGO_INITDB_ROOT_USERNAME: root
      MONGO_INITDB_ROOT_PASSWORD_FILE: /etc/mongodb/root.pass
    volumes:
      - {{ mongodb_stack_dir }}/secrets:/etc/mongodb:ro
      - data:/data/db
      - config:/data/configdb
    tmpfs:
      - /tmp
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--norc", "--port", "{{ mongodb_port }}", "--eval", "quit(db.adminCommand('ping').ok ? 0 : 1)"]
      interval: 60s
      timeout: 15s
      retries: 3
      start_period: 60s

volumes:
  data:
  config:
