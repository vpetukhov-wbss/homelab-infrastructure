# Managed by Ansible (homelab) — node2 data-primary stack
# Published ports bind ONLY to the WireGuard overlay IP ({{ wg_overlay_ip }}),
# so nothing is reachable on the LAN/public — Docker never lands these on 0.0.0.0.
services:
  postgres-primary:
    image: {{ image_postgres }}
    container_name: postgres-primary
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: "{{ vault_pg_password }}"
      POSTGRES_DB: homelab
      POSTGRES_INITDB_ARGS: "--auth-host=scram-sha-256"
    volumes:
      - pg_primary_data:/var/lib/postgresql/data
      # A directory, not single files: Ansible's template writes a new inode, which a
      # single-file bind mount never sees — the container would reload stale config.
      - {{ stack_dir }}/pgconf:/etc/postgresql:ro
    command: >
      postgres
      -c config_file=/etc/postgresql/postgresql.conf
      -c hba_file=/etc/postgresql/pg_hba.conf
    ports:
      - "{{ wg_overlay_ip }}:5432:5432"
    # A clean shutdown on a busy HDD can exceed Docker's 10 s default; SIGKILL would
    # force crash recovery on the next start.
    stop_grace_period: 60s
    shm_size: 256mb
    # If memory runs out, the kernel should kill anything but the database.
    oom_score_adj: -500
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d homelab"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Container name is historical: Sentinel decides which node is master. Query the
  # service, never the name.
  redis-primary:
    image: {{ image_redis }}
    container_name: redis-primary
    restart: unless-stopped
    command: ["redis-server", "/usr/local/etc/redis/redis.conf"]
    environment:
      # redis-cli inside the container authenticates from this, so neither the
      # healthcheck nor the roles put the password on a command line.
      REDISCLI_AUTH: "{{ vault_redis_password }}"
    volumes:
      # A directory, so Redis can persist role changes (CONFIG REWRITE) after a failover.
      - {{ stack_dir }}/redis:/usr/local/etc/redis
      - redis_primary_data:/data
    ports:
      - "{{ wg_overlay_ip }}:6379:6379"
    mem_limit: 512m
    oom_score_adj: -500
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 10

volumes:
  pg_primary_data:
  redis_primary_data:
