# Managed by Ansible (homelab) — node2 Postgres PRIMARY
# Tuned for a 3.7GB RAM box on a spinning HDD (mostly dedicated to PG + a light Redis).
listen_addresses = '*'
port = 5432
max_connections = 100

# Memory (≈ leave ~2GB for OS + Redis + page cache)
shared_buffers = 768MB
effective_cache_size = 2304MB
maintenance_work_mem = 128MB
work_mem = 8MB

# WAL / replication (streaming to node3 replica)
wal_level = replica
max_wal_senders = 5
max_replication_slots = 5
wal_compression = lz4
hot_standby = on
synchronous_commit = on          # local durability kept; replication is ASYNC (no synchronous_standby_names)
# Without hint-bit WAL logging (or data checksums) pg_rewind refuses to run, and the
# only way back after a promotion is a full re-basebackup.
wal_log_hints = on
# Nodes have vanished for days. An unlimited slot would keep WAL until this node's only
# disk filled and the primary PANICked. Past this, the slot is invalidated instead and
# the standby must be re-seeded deliberately.
max_slot_wal_keep_size = 20GB

# Checkpoints: fewer, smoother write bursts on a single spindle
max_wal_size = 4GB
min_wal_size = 512MB
checkpoint_timeout = 15min
checkpoint_completion_target = 0.9

# HDD-aware planner/IO
random_page_cost = 4.0
effective_io_concurrency = 2

# Logging (light)
logging_collector = off
log_min_duration_statement = 1000
log_checkpoints = on
