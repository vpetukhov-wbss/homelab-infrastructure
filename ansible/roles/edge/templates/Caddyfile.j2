# Managed by Ansible (homelab) — node1 edge reverse proxy
{
	admin off
	auto_https off
}

# Public ingress on :80 (router forwards 80/443 here). Real service routes
# (reverse_proxy to Gitea over the overlay, etc.) get added as services come online.
:80 {
	handle /health {
		respond "ok" 200
	}
	handle {
		respond "homelab edge (Caddy) up — reverse proxy ready" 200
	}
}
