# Managed by Ansible (homelab).
[Unit]
Description=Wi-Fi power saving off on %i
# Bound to the device: a recreated interface is back at the kernel's default, which is on.
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/iw dev %i set power_save off

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
