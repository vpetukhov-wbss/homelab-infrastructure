# Managed by Ansible (homelab) — Redis Sentinel on {{ inventory_hostname }}
services:
  redis-sentinel:
    image: {{ image_redis }}
    container_name: redis-sentinel
    restart: unless-stopped
    user: "999:999"
    command: ["redis-sentinel", "/etc/redis-sentinel/sentinel.conf"]
    volumes:
      # A directory, not a file — see sentinel_conf_dir in defaults/main.yml.
      - {{ sentinel_conf_dir }}:/etc/redis-sentinel
    ports:
      - "{{ wg_overlay_ip }}:26379:26379"
    mem_limit: 64m
