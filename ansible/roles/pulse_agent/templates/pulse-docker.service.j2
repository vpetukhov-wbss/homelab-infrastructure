[Unit]
Description=Inspect approved Docker containers for HomeLab Pulse
After=docker.service

[Service]
Type=oneshot
User=pulse-docker
Group=pulse-agent
SupplementaryGroups=docker
WorkingDirectory=/opt/pulse-agent
ExecStart={{ pulse_agent_python_path }} -B -m pulse_agent.docker_probe %d/containers /run/pulse-docker
LoadCredential=containers:/etc/pulse-agent/docker-containers.json
RuntimeDirectory=pulse-docker
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027
TimeoutStartSec=20s
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
InaccessiblePaths=-/etc/pulse-agent -/var/lib/pulse-agent -/run/pulse-smart
