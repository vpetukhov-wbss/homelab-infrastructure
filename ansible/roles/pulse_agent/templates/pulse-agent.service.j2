[Unit]
Description=Collect and send HomeLab Pulse host telemetry
After=network-online.target wg-quick@wg1.service homelab-overlay-guard.service
Wants=network-online.target
Requisite=wg-quick@wg1.service homelab-overlay-guard.service

[Service]
Type=oneshot
User=pulse-agent
WorkingDirectory=/opt/pulse-agent
ExecStart={{ pulse_agent_python_path }} -B -m pulse_agent --config /etc/pulse-agent/agent.ini tick
LoadCredential=ingest-token:/etc/pulse-agent/ingest-token
{% if pulse_agent_redis_host %}
LoadCredential=redis-password:/etc/pulse-agent/redis-password
{% endif %}
{% if pulse_agent_postgres_host %}
LoadCredential=postgres-pgpass:/etc/pulse-agent/postgres-pgpass
{% endif %}
{% if pulse_agent_rabbitmq_host %}
LoadCredential=rabbitmq-password:/etc/pulse-agent/rabbitmq-password
{% endif %}
StateDirectory=pulse-agent
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec={{ 12 + (2 if pulse_agent_postgres_host else 0) + (2 if pulse_agent_rabbitmq_host else 0) + (2 if pulse_agent_gitea_health_url else 0) + (2 if pulse_agent_tls_host else 0) }}s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
InaccessiblePaths=-/run/docker.sock
