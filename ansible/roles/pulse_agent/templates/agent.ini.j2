[agent]
ingest_url = {{ pulse_agent_ingest_url }}
state_directory = /var/lib/pulse-agent
timeout_seconds = 2
max_pending = 512
max_age_seconds = 86400
send_limit = 4
{% if pulse_agent_nginx_status_url %}
nginx_status_url = {{ pulse_agent_nginx_status_url }}
{% endif %}
{% if pulse_agent_gitea_health_url %}
gitea_health_url = {{ pulse_agent_gitea_health_url }}
{% endif %}

[filesystems]
{% for alias, path in pulse_agent_filesystems | dictsort %}
{{ alias }} = {{ path }}
{% endfor %}

[network]
{% for alias, device in pulse_agent_interfaces | dictsort %}
{{ alias }} = {{ device }}
{% endfor %}

[temperatures]
{% for alias, path in pulse_agent_temperatures | dictsort %}
{{ alias }} = {{ path }}
{% endfor %}

[fans]
{% for alias, path in pulse_agent_fans | dictsort %}
{{ alias }} = {{ path }}
{% endfor %}

[disks]
{% for alias, device in pulse_agent_disks | dictsort %}
{{ alias }} = {{ device }}
{% endfor %}

[smart_snapshots]
{% for alias, path in pulse_agent_smart_snapshots | dictsort %}
{% if alias not in pulse_agent_smart_devices %}
{{ alias }} = {{ path }}
{% endif %}
{% endfor %}
{% for alias in pulse_agent_smart_devices | sort %}
{{ alias }} = /run/pulse-smart/{{ alias }}.json
{% endfor %}

[docker_snapshots]
{% for alias in pulse_agent_docker_containers | sort %}
{{ alias }} = /run/pulse-docker/{{ alias }}.json
{% endfor %}

[docker_volume_snapshots]
{% for alias in pulse_agent_docker_volume_paths | sort %}
{{ alias }} = /run/pulse-volume/{{ alias }}.json
{% endfor %}

[sqlite_databases]
{% for alias, path in pulse_agent_sqlite_databases | dictsort %}
{{ alias }} = {{ path }}
{% endfor %}

{% if pulse_agent_redis_host %}
[redis]
host = {{ pulse_agent_redis_host }}
port = {{ pulse_agent_redis_port }}
username = {{ pulse_agent_redis_username }}
{% endif %}

{% if pulse_agent_postgres_host %}
[postgresql]
host = {{ pulse_agent_postgres_host }}
port = {{ pulse_agent_postgres_port }}
database = {{ pulse_agent_postgres_database }}
username = {{ pulse_agent_postgres_username }}
{% endif %}

{% if pulse_agent_rabbitmq_host %}
[rabbitmq]
host = {{ pulse_agent_rabbitmq_host }}
port = {{ pulse_agent_rabbitmq_port }}
vhost = {{ pulse_agent_rabbitmq_vhost }}
queue = {{ pulse_agent_rabbitmq_queue }}
username = {{ pulse_agent_rabbitmq_username }}
{% endif %}
