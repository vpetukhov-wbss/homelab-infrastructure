# Managed by Ansible (homelab) — node3 Postgres STANDBY
# Until 2026-11-21 the standby ran on the image's default pg_hba (local/loopback only):
# after a promotion neither the applications nor node2 could have connected to it.
# TYPE  DATABASE        USER            ADDRESS                 METHOD
local   all             all                                     trust
host    all             all             127.0.0.1/32            scram-sha-256
# Read-only clients over the overlay today; full access once promoted.
host    all             all             10.44.0.0/24            scram-sha-256
# After a promotion, the old primary re-seeds (pg_basebackup / pg_rewind) from here.
host    replication     replicator      {{ hostvars[groups['data_primary'][0]].wg_overlay_ip }}/32   scram-sha-256
