# Managed by Ansible (homelab) — node3 data-replica stack
# PG data is a bind mount ({{ stack_dir }}/pgdata) seeded by pg_basebackup before first start.
# Published ports bind ONLY to the overlay IP ({{ wg_overlay_ip }}).
services:
  postgres-replica:
    image: {{ image_postgres }}
    container_name: postgres-replica
    restart: unless-stopped
    user: "999:999"
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: "{{ vault_pg_password }}"
    volumes:
      - {{ stack_dir }}/pgdata:/var/lib/postgresql/data
      # A directory, not single files: Ansible's template writes a new inode, which a
      # single-file bind mount never sees — the container would reload stale config.
      - {{ stack_dir }}/pgconf:/etc/postgresql:ro
    command: >
      postgres
      -c config_file=/etc/postgresql/postgresql.conf
      -c hba_file=/etc/postgresql/pg_hba.conf
    ports:
      - "{{ wg_overlay_ip }}:5432:5432"
    stop_grace_period: 60s
    shm_size: 256mb
    oom_score_adj: -500
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Container name is historical: after the 2026-11-18 failover this is the Redis
  # MASTER. Sentinel decides roles — query the service, never the name.
  redis-replica:
    image: {{ image_redis }}
    container_name: redis-replica
    restart: unless-stopped
    command: ["redis-server", "/usr/local/etc/redis/redis.conf"]
    environment:
      # redis-cli inside the container authenticates from this, so neither the
      # healthcheck nor the roles put the password on a command line.
      REDISCLI_AUTH: "{{ vault_redis_password }}"
    volumes:
      # A directory, so Redis can persist role changes (CONFIG REWRITE) after a failover.
      - {{ stack_dir }}/redis:/usr/local/etc/redis
      - redis_replica_data:/data
    ports:
      - "{{ wg_overlay_ip }}:6379:6379"
    mem_limit: 512m
    oom_score_adj: -500
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 10

volumes:
  redis_replica_data:
