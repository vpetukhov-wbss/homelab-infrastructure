# Managed by Ansible (homelab) — node3 data-replica stack
# PG data is a bind mount ({{ stack_dir }}/pgdata) seeded by pg_basebackup before first start.
# Published ports bind ONLY to the overlay IP ({{ wg_overlay_ip }}).
services:
  postgres-replica:
    image: postgres:16
    container_name: postgres-replica
    restart: unless-stopped
    user: "999:999"
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: "{{ vault_pg_password }}"
    volumes:
      - {{ stack_dir }}/pgdata:/var/lib/postgresql/data
      - {{ stack_dir }}/postgresql.conf:/etc/postgresql/postgresql.conf:ro
    command: >
      postgres
      -c config_file=/etc/postgresql/postgresql.conf
    ports:
      - "{{ wg_overlay_ip }}:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 10

  redis-replica:
    image: redis:7-alpine
    container_name: redis-replica
    restart: unless-stopped
    command: ["redis-server", "/etc/redis/redis.conf"]
    volumes:
      - {{ stack_dir }}/redis.conf:/etc/redis/redis.conf:ro
      - redis_replica_data:/data
    ports:
      - "{{ wg_overlay_ip }}:6379:6379"
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a {{ vault_redis_password }} ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 10

volumes:
  redis_replica_data:
