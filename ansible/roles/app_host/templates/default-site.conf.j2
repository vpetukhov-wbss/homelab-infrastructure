# Managed by Ansible (homelab) — default vhost.
# Drop your own vhosts next to this file in {{ app_sites_dir }}; they are included
# automatically. Proxy to app containers by name on the shared `apphost` network, e.g.
#
#   location /myapp/ { proxy_pass http://myapp:3000/; }
#
server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Used by Caddy and by the deploy playbook to confirm this host is serving.
    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
