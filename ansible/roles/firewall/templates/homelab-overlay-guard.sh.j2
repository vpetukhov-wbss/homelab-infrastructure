#!/bin/sh
# Managed by Ansible (homelab) — see roles/firewall/defaults/main.yml for why this exists.
# apply : drop overlay-subnet packets that did not arrive via an allowed interface, and
#         make the overlay unreachable (instead of routed to the ISP) when wg1 is down
# remove: undo both
set -eu
CIDR="{{ overlay_guard_cidr }}"
CHAIN="HOMELAB-OVERLAY-GUARD"
METRIC="{{ overlay_guard_unreachable_metric }}"
ipt() { iptables -w -t raw "$@"; }

case "${1:-apply}" in
  apply)
    ipt -N "$CHAIN" 2>/dev/null || ipt -F "$CHAIN"
{% for iface in overlay_guard_allowed_interfaces %}
    ipt -A "$CHAIN" -i {{ iface }} -j RETURN
{% endfor %}
    ipt -A "$CHAIN" -j DROP
    ipt -C PREROUTING -d "$CIDR" -j "$CHAIN" 2>/dev/null || ipt -I PREROUTING 1 -d "$CIDR" -j "$CHAIN"
    ip route replace unreachable "$CIDR" metric "$METRIC"
    ;;
  remove)
    ipt -D PREROUTING -d "$CIDR" -j "$CHAIN" 2>/dev/null || true
    ipt -F "$CHAIN" 2>/dev/null || true
    ipt -X "$CHAIN" 2>/dev/null || true
    ip route del unreachable "$CIDR" metric "$METRIC" 2>/dev/null || true
    ;;
  *)
    echo "usage: $0 apply|remove" >&2; exit 2 ;;
esac
