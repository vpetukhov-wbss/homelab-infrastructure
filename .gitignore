# ---------------------------------------------------------------------------
# HomeLab infrastructure. This repository is PUBLIC.
# These patterns are a safety net, not a control: never stage a secret.
# ---------------------------------------------------------------------------

# Real inventory and ansible-vault secrets (templates: inventory/*.example.yml)
inventory/hosts.yml
inventory/hosts.yml.*
inventory/local.yml
ansible/inventory/local*
**/vault.yml
**/db_secrets.yml
**/*.vault
*vault-pass*
.homelab_vault_pass
.homelab_recovery_pass
*.retry

# Installer build output (real disk serials, keys, Wi-Fi PSK; multi-GB images)
installer/build/
*.iso

# Recovery bundles, backups and backup copies of any file
*.tar.gpg
backups/
Backup*/
*.bak
*.bak-*
*.orig

# Keys, certificates, tokens
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
**/wireguard/privatekey
**/wg-private.conf
**/.vault-token
**/vault-init.json
**/unseal-keys.*
**/recovery-keys.*
**/age/keys.txt
**/keys.txt

# Environment files and generic secret holders
.env
.env.*
*.env
!.env.example
*.secret
*.secrets
secrets/
private/
credentials/

# SOPS / decrypted material
*.dec.yaml
*.dec.yml
*.decrypted.*

# Terraform is not used; kept so state can never be committed by accident
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.auto.tfvars
crash.log
crash.*.log

# Runtime data and logs
data/
volumes/
logs/
*.log
*.tmp

# Python and tooling
__pycache__/
*.pyc
.venv/

# Editors and OS files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
